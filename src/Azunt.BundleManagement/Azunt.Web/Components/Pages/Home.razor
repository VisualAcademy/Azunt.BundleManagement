@page "/"

<PageTitle>Azunt Bundle Management</PageTitle>

<div class="mb-4">
    <h1>Azunt.BundleManagement</h1>
    <p class="lead">Reusable .NET 8 Bundle management with offset-aware audit timestamps.</p>
    <div class="alert alert-info">
        This demo uses EF Core In-Memory. Open <a href="Bundles">Bundles</a> to test create, read, update, delete, search, filters, sorting, paging, and time-zone-aware timestamps.
    </div>
</div>

<div class="row">
    <div class="col-12 col-xl-7">
        <RecentBundles Count="5"
                       Title="Recent Bundles"
                       Subtitle="Recently created or updated"
                       ListUrl="/Bundles"
                       MoreText="View all" />
    </div>
</div>
