@rendermode InteractiveServer
@using System.Globalization
@inject IBundleRepository Repository
@inject IJSRuntime JS

<div class="card shadow-sm h-100">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <div>
            <strong>@Title</strong>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <div class="small text-muted">@Subtitle</div>
            }
        </div>

        <a class="btn btn-sm btn-outline-primary" href="@ListUrl">
            @MoreText
        </a>
    </div>

    <div class="list-group list-group-flush">
        @if (loading)
        {
            <div class="list-group-item text-muted py-3">
                Loading...
            </div>
        }
        else if (items.Count == 0)
        {
            <div class="list-group-item text-muted py-3">
                No bundle records.
            </div>
        }
        else
        {
            @foreach (var item in items)
            {
                var activityAt = item.ModifiedAt ?? item.CreatedAt;
                var activityLabel = item.ModifiedAt.HasValue ? "Updated" : "Created";

                <div class="list-group-item py-3">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div class="min-w-0">
                            <div class="fw-semibold text-truncate">
                                @item.Name
                            </div>

                            <div class="small text-muted text-truncate">
                                @Display(item.Code)
                                @if (!string.IsNullOrWhiteSpace(item.Version))
                                {
                                    <span> · v@item.Version</span>
                                }
                            </div>
                        </div>

                        <span class="badge @StatusBadge(item.Status, item.IsActive)">
                            @Display(item.Status)
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                        <span>@activityLabel</span>
                        <span>@FormatDate(activityAt)</span>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    /// <summary>
    /// Number of recent Bundle records shown by the dashboard summary.
    /// The repository clamps the value to 1-50.
    /// </summary>
    [Parameter]
    public int Count { get; set; } = 5;

    [Parameter]
    public string Title { get; set; } = "Recent Bundles";

    [Parameter]
    public string Subtitle { get; set; } = "Recently created or updated";

    [Parameter]
    public string ListUrl { get; set; } = "/Bundles";

    [Parameter]
    public string MoreText { get; set; } = "View all";

    private List<Bundle> items = [];
    private bool loading = true;

    private int browserOffsetMinutes;
    private string browserCulture = "en-US";
    private bool browserSettingsLoaded;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        items = await Repository.GetRecentAsync(Count);
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            browserOffsetMinutes =
                await JS.InvokeAsync<int>(
                    "azuntBundleTimeZone.getLocalOffsetMinutes");

            var culture =
                await JS.InvokeAsync<string>(
                    "azuntBundleTimeZone.getBrowserCulture");

            if (!string.IsNullOrWhiteSpace(culture))
            {
                browserCulture = culture;
            }

            browserSettingsLoaded = true;
            StateHasChanged();
        }
        catch
        {
            browserOffsetMinutes = 0;
            browserCulture = "en-US";
            browserSettingsLoaded = false;
        }
    }

    private TimeSpan GetBrowserOffset()
    {
        var minutes =
            browserSettingsLoaded
                ? Math.Clamp(browserOffsetMinutes, -14 * 60, 14 * 60)
                : 0;

        return TimeSpan.FromMinutes(minutes);
    }

    private CultureInfo GetBrowserCulture()
    {
        try
        {
            return CultureInfo.GetCultureInfo(browserCulture);
        }
        catch (CultureNotFoundException)
        {
            return CultureInfo.GetCultureInfo("en-US");
        }
    }

    private string FormatDate(DateTimeOffset? value)
    {
        if (!value.HasValue)
        {
            return "-";
        }

        return value.Value
            .ToOffset(GetBrowserOffset())
            .ToString("g", GetBrowserCulture());
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string StatusBadge(string? status, bool active)
    {
        if (!active)
        {
            return "text-bg-secondary";
        }

        return status?.ToLowerInvariant() switch
        {
            "active" => "text-bg-success",
            "draft" => "text-bg-warning",
            "inactive" => "text-bg-secondary",
            "retired" => "text-bg-dark",
            _ => "text-bg-light"
        };
    }
}
