<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <title>@ViewData["Title"] - Azunt.BundleManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/app.css" />
</head>
<body>
    <div class="page-shell">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="~/">Azunt.BundleManagement</a>
                <div class="navbar-nav">
                    <a class="nav-link" href="~/">Home</a>
                    <a class="nav-link" href="~/Bundles">Blazor Bundles</a>
                    <a class="nav-link active" href="~/DotNetNote/Bundles/">DotNetNote Bundles</a>
                </div>
            </div>
        </nav>

        <main class="container py-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/timezone.js"></script>
    <script src="~/_framework/blazor.server.js" autostart="false"></script>
    <script>
        Blazor.start({
            configureSignalR: builder => builder.withUrl("/dotnetnote-blazor")
        });
    </script>
    <persist-component-state />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
